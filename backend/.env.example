# VendoCasa Backend Configuration
# Copy this file to .env and fill in your values. Every variable is documented
# in docs/deployment.md.

# PostgreSQL connection (with PostGIS)
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST:PORT/DIR

# Data directory for OMI zip files
DATA_DIR=./data

# Google Geocoding API key (optional fallback after Photon and Nominatim;
# each Google request is charged to the requesting account's allowance)
GOOGLE_GEOCODING_API_KEY=

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Anthropic API key (required for AI chat agent)
# Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Supabase Auth: project URL, accepted token algorithm, and (only for HS256)
# the project's JWT secret. Without SUPABASE_URL every API route refuses.
SUPABASE_URL=
SUPABASE_JWT_ALGORITHM=ES256
SUPABASE_JWT_SECRET=

# The owner account's ID (token subject): writes transactions, reads spending
OWNER_USER_ID=

# Monthly spending caps in US dollars (per account, and all accounts together)
ACCOUNT_MONTHLY_CAP_USD=1.0
GLOBAL_MONTHLY_CAP_USD=100.0
